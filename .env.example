# Preencha com os dados do seu projeto Supabase (Project Settings > API)
# NUNCA envie chaves de serviço (service_role) para o frontend nem faça commit do arquivo .env

NEXT_PUBLIC_SUPABASE_URL=https://sua-url-aqui.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica-aqui
# Alternativa aceita pelo cliente (use uma das duas chaves públicas):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-publishable-key-publica-aqui
